# Base de dados
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=recruiter_db
DB_USERNAME=recruiter_user
DB_PASSWORD=recruiter_pass

# Alternativa: definir DATABASE_URL diretamente sobrepõe as variáveis DB_* acima.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database

# Segurança / JWT
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
